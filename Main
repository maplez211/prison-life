-- Main Script Precision | Prison Life

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer
while not player do task.wait() player = Players.LocalPlayer end
local playerGui = player:WaitForChild("PlayerGui")
local camera = workspace.CurrentCamera

-- ============ SETTINGS ============
getgenv().SilentAimSettings = {
    Enabled = true,
    TargetPart = "HumanoidRootPart",
    Method = "Raycast",
    VisibleCheck = true,
    TeamCheck = true,
    Smoothing = 0.5,
    HitChance = 100,
    FOVEnabled = true,
    FOVRadius = 100,
    FOVColor = Color3.fromRGB(255, 255, 255),
    FOVThickness = 1.5,
    FriendCheck = true,
    SpinbotSpeed = 0,
    ESPEnabled = false,
    ESPNamesEnabled = true,
    IgnoreInmates = false,
    IgnoreGuards = false,
    IgnoreCriminals = false,
    HostileCheck = false,
    TrespassCheck = false,
    TracerEnabled = false,
    TracerOrigin = "Bottom", 
    TracerColor = Color3.fromRGB(255, 255, 255),
    TracerThickness = 1,
    TracerTransparency = 1,
    TracerOnlyTarget = true, 
    TracerAllPlayers = false,
    TargetOnPlayer = nil
}

local Settings = getgenv().SilentAimSettings
local currentSkybox = nil
local smoothedTargetPosition = nil
local currentTarget = nil
local lastTargetPlayer = nil

-- ============ FOV CIRCLE ============
local fovCircle = Drawing.new("Circle")
fovCircle.Visible = Settings.Enabled and Settings.FOVEnabled
fovCircle.Radius = Settings.FOVRadius
fovCircle.Color = Settings.FOVColor
fovCircle.Thickness = Settings.FOVThickness
fovCircle.Filled = false
fovCircle.Transparency = 1

local function toggleFOVCircle(hide)
    fovCircle.Visible = not hide and Settings.Enabled and Settings.FOVEnabled
end

-- ============ TRACER SYSTEM ============
local TracerDrawings = {}

local function getTracerOrigin()
    local origin = Settings.TracerOrigin
    if origin == "Bottom" then
        return Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
    elseif origin == "Top" then
        return Vector2.new(camera.ViewportSize.X / 2, 0)
    elseif origin == "Mouse" then
        return UserInputService:GetMouseLocation()
    else 
        return Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    end
end

local function createTracer(plr)
    if TracerDrawings[plr] then
        TracerDrawings[plr]:Remove()
    end
    
    local tracer = Drawing.new("Line")
    tracer.Visible = false
    tracer.Color = Settings.TracerColor
    tracer.Thickness = Settings.TracerThickness
    tracer.Transparency = Settings.TracerTransparency
    
    TracerDrawings[plr] = tracer
    return tracer
end

local function removeTracer(plr)
    if TracerDrawings[plr] then
        TracerDrawings[plr]:Remove()
        TracerDrawings[plr] = nil
    end
end

local function removeAllTracers()
    for plr, tracer in pairs(TracerDrawings) do
        if tracer then
            tracer:Remove()
        end
    end
    TracerDrawings = {}
end

local function updateTracers()
    if not Settings.TracerEnabled then
        for _, tracer in pairs(TracerDrawings) do
            tracer.Visible = false
        end
        return
    end
    
    local origin = getTracerOrigin()
    
    if Settings.TracerOnlyTarget then
        -- Mostrar tracer apenas no alvo atual
        for plr, tracer in pairs(TracerDrawings) do
            local isTarget = false
            
            if currentTarget and currentTarget.Parent then
                local targetPlayer = Players:GetPlayerFromCharacter(currentTarget.Parent)
                if targetPlayer == plr then
                    isTarget = true
                end
            end
            
            if isTarget and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = plr.Character.HumanoidRootPart
                local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
                
                if onScreen then
                    tracer.From = origin
                    tracer.To = Vector2.new(screenPos.X, screenPos.Y)
                    tracer.Color = Color3.fromRGB(255, 182, 255) -- Rosa para o target
                    tracer.Visible = true
                else
                    tracer.Visible = false
                end
            else
                tracer.Visible = false
            end
        end
    elseif Settings.TracerAllPlayers then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player then
                local tracer = TracerDrawings[plr]
                if not tracer then
                    tracer = createTracer(plr)
                end
                
                if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = plr.Character.HumanoidRootPart
                    local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
                    
                    if humanoid and humanoid.Health > 0 then
                        local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
                        
                        if onScreen then
                            tracer.From = origin
                            tracer.To = Vector2.new(screenPos.X, screenPos.Y)
                            
                            local isTarget = false
                            if currentTarget and currentTarget.Parent then
                                local targetPlayer = Players:GetPlayerFromCharacter(currentTarget.Parent)
                                if targetPlayer == plr then
                                    isTarget = true
                                end
                            end
                            
                            if isTarget then
                                tracer.Color = Color3.fromRGB(255, 182, 255) -- Rosa
                            else
                                tracer.Color = Settings.TracerColor
                            end
                            
                            tracer.Visible = true
                        else
                            tracer.Visible = false
                        end
                    else
                        tracer.Visible = false
                    end
                else
                    tracer.Visible = false
                end
            end
        end
    end
end

function setTracerEnabled(enabled)
    Settings.TracerEnabled = enabled
    if not enabled then
        removeAllTracers()
    end
end

function setTracerOrigin(origin)
    Settings.TracerOrigin = origin
end

function setTracerColor(color)
    Settings.TracerColor = color
    for _, tracer in pairs(TracerDrawings) do
        tracer.Color = color
    end
end

function setTracerThickness(thickness)
    Settings.TracerThickness = thickness
    for _, tracer in pairs(TracerDrawings) do
        tracer.Thickness = thickness
    end
end

function setTracerTransparency(transparency)
    Settings.TracerTransparency = transparency
    for _, tracer in pairs(TracerDrawings) do
        tracer.Transparency = transparency
    end
end

-- ============ MAIN FUNCTIONS ============
local function isVisible(targetCharacter)
    if not targetCharacter then return false end
    local hrp = targetCharacter:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local origin = camera.CFrame.Position
    local direction = hrp.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = {player.Character, targetCharacter}
    return Workspace:Raycast(origin, direction, params) == nil
end

local function isValidTarget(plr)
    if not plr or plr == player then return false end
    if not plr.Character then return false end
    
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
    if not hum or hum.Health <= 0 or not hrp then return false end
    
    if Settings.FriendCheck and player:IsFriendsWith(plr.UserId) then return false end
    
    if Settings.TeamCheck then
        if player.Team and plr.Team == player.Team then return false end
    end
    
    if Settings.IgnoreInmates and plr.Team and plr.Team.Name == "Inmates" then return false end
    if Settings.IgnoreGuards and plr.Team and plr.Team.Name == "Guards" then return false end
    if Settings.IgnoreCriminals and plr.Team and plr.Team.Name == "Criminals" then return false end
    
    if Settings.VisibleCheck then
        if not isVisible(plr.Character) then return false end
    end
    
    if Settings.HostileCheck or Settings.TrespassCheck then
        local isGuard = player.Team and player.Team.Name == "Guards"
        local isInmate = plr.Team and plr.Team.Name == "Inmates"
        
        if isGuard and isInmate then
            local hostile = plr.Character:GetAttribute("Hostile")
            local trespass = plr.Character:GetAttribute("Trespassing")
            
            if Settings.HostileCheck and Settings.TrespassCheck then
                if not hostile and not trespass then return false end
            elseif Settings.HostileCheck then
                if not hostile then return false end
            elseif Settings.TrespassCheck then
                if not trespass then return false end
            end
        end
    end
    
    return true
end

local function getClosestTarget()
    if Settings.TargetOnPlayer then
        local targetPlr = Players:FindFirstChild(Settings.TargetOnPlayer)
        if targetPlr and isValidTarget(targetPlr) then
            local part = targetPlr.Character:FindFirstChild(Settings.TargetPart) or targetPlr.Character:FindFirstChild("HumanoidRootPart")
            if part then return part end
        end
        return nil
    end
    
    local localRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not localRoot then return nil end
    
    local screenCenter = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
    local mousePos = UserInputService:GetMouseLocation()
    local useMouse = not UserInputService.TouchEnabled
    
    local closest = nil
    local shortestDistance = math.huge
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if isValidTarget(plr) then
            local part = plr.Character:FindFirstChild(Settings.TargetPart) or plr.Character:FindFirstChild("HumanoidRootPart")
            if part then
                local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local screenDist
                    if useMouse then
                        screenDist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(mousePos.X, mousePos.Y)).Magnitude
                    else
                        screenDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    end
                    
                    if screenDist <= Settings.FOVRadius then
                        local worldDist = (part.Position - localRoot.Position).Magnitude
                        if worldDist < shortestDistance then
                            closest = part
                            shortestDistance = worldDist
                        end
                    end
                end
            end
        end
    end
    return closest
end

local function updateFOVPosition()
    if not fovCircle then return end
    if UserInputService.TouchEnabled then
        fovCircle.Position = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    else
        local mousePos = UserInputService:GetMouseLocation()
        fovCircle.Position = Vector2.new(mousePos.X, mousePos.Y)
    end
end

-- ============ SILENT AIM HOOK ============
local ExpectedArguments = {
    FindPartOnRayWithIgnoreList = {
        ArgCountRequired = 3,
        Args = { "Instance", "Ray", "table", "boolean", "boolean" }
    },
    FindPartOnRayWithWhitelist = {
        ArgCountRequired = 3,
        Args = { "Instance", "Ray", "table", "boolean" }
    },
    FindPartOnRay = {
        ArgCountRequired = 2,
        Args = { "Instance", "Ray", "Instance", "boolean", "boolean" }
    },
    Raycast = {
        ArgCountRequired = 3,
        Args = { "Instance", "Vector3", "Vector3", "RaycastParams" }
    }
}

local function CalculateChance(Percentage)
    Percentage = math.floor(Percentage)
    local chance = math.floor(Random.new().NextNumber(Random.new(), 0, 1) * 100) / 100
    return chance <= Percentage / 100
end

local function ValidateArguments(Args, RayMethod)
    local Matches = 0
    if #Args < RayMethod.ArgCountRequired then return false end
    for Pos, Argument in next, Args do
        if typeof(Argument) == RayMethod.Args[Pos] then
            Matches = Matches + 1
        end
    end
    return Matches >= RayMethod.ArgCountRequired
end

local function getSpreadDirection(Origin, OriginalDirection, HitPart)
    if typeof(HitPart) ~= "Instance" or not HitPart.Parent then 
        return OriginalDirection 
    end
    
    local OriginalDistance = OriginalDirection.Magnitude
    if OriginalDistance == 0 then OriginalDistance = 1000 end
    
    local PartSize = HitPart.Size
    local SpreadX = (math.random() - 0.5) * (PartSize.X + 2) * 0.2
    local SpreadY = (math.random() - 0.5) * (PartSize.Y + 2) * 0.2
    local SpreadZ = (math.random() - 0.5) * (PartSize.Z + 2) * 0.2
    
    local RandomOffset = Vector3.new(SpreadX, SpreadY, SpreadZ)
    if RandomOffset.Magnitude == 0 then
        RandomOffset = Vector3.new(0.1, 0.1, 0.1)
    end
    
    local BasePosition = smoothedTargetPosition or HitPart.Position
    local TargetPosition = BasePosition + RandomOffset
    
    local NewDirection = (TargetPosition - Origin)
    local NewDistance = NewDirection.Magnitude
    
    if NewDistance == 0 then
        return OriginalDirection
    end
    
    local FinalDistance = math.max(OriginalDistance, NewDistance)
    return NewDirection.Unit * FinalDistance
end

local function isLocalPlayerShooting(Arguments, Method, Origin, OriginalDirection)
    local LocalChar = player.Character
    if not LocalChar then return false end

    local rayLength = OriginalDirection and OriginalDirection.Magnitude or 0

    if Origin and (Origin - camera.CFrame.Position).Magnitude <= 2 then
        if rayLength < 30 then
            return false
        end
    end

    local ignoreList = nil
    if Method == "Raycast" then
        local params = Arguments[4]
        if typeof(params) == "RaycastParams" then
            ignoreList = params.FilterDescendantsInstances
        end
    elseif Method == "FindPartOnRayWithIgnoreList" then
        if typeof(Arguments[3]) == "table" then
            ignoreList = Arguments[3]
        end
    elseif Method == "FindPartOnRay" or Method == "findPartOnRay" then
        if typeof(Arguments[3]) == "table" then
            ignoreList = Arguments[3]
        elseif typeof(Arguments[4]) == "table" then
            ignoreList = Arguments[4]
        end
    end

    if ignoreList then
        for _, inst in next, ignoreList do
            if inst == LocalChar then
                return true
            end
        end
    end

    if Origin and (Origin - camera.CFrame.Position).Magnitude <= 2 then
        return true
    end

    return false
end

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(...)
    local Method = getnamecallmethod()
    local Arguments = {...}
    local self = Arguments[1]
    local chance = CalculateChance(Settings.HitChance)
    
    if Settings.Enabled and self == workspace and not checkcaller() and chance == true then
        if Method == "FindPartOnRayWithIgnoreList" and Settings.Method == Method then
            if ValidateArguments(Arguments, ExpectedArguments.FindPartOnRayWithIgnoreList) then
                local A_Ray = Arguments[2]
                local Origin = A_Ray.Origin
                
                if isLocalPlayerShooting(Arguments, Method, Origin, A_Ray.Direction) then
                    local HitPart = currentTarget
                    if HitPart and HitPart.Parent then
                        Arguments[2] = Ray.new(Origin, getSpreadDirection(Origin, A_Ray.Direction, HitPart))
                        return oldNamecall(unpack(Arguments))
                    end
                end
            end
        elseif Method == "FindPartOnRayWithWhitelist" and Settings.Method == Method then
            if ValidateArguments(Arguments, ExpectedArguments.FindPartOnRayWithWhitelist) then
                local A_Ray = Arguments[2]
                local Origin = A_Ray.Origin
                
                if isLocalPlayerShooting(Arguments, Method, Origin, A_Ray.Direction) then
                    local HitPart = currentTarget
                    if HitPart and HitPart.Parent then
                        Arguments[2] = Ray.new(Origin, getSpreadDirection(Origin, A_Ray.Direction, HitPart))
                        return oldNamecall(unpack(Arguments))
                    end
                end
            end
        elseif (Method == "FindPartOnRay" or Method == "findPartOnRay") and Settings.Method:lower() == Method:lower() then
            if ValidateArguments(Arguments, ExpectedArguments.FindPartOnRay) then
                local A_Ray = Arguments[2]
                local Origin = A_Ray.Origin
                
                if isLocalPlayerShooting(Arguments, Method, Origin, A_Ray.Direction) then
                    local HitPart = currentTarget
                    if HitPart and HitPart.Parent then
                        Arguments[2] = Ray.new(Origin, getSpreadDirection(Origin, A_Ray.Direction, HitPart))
                        return oldNamecall(unpack(Arguments))
                    end
                end
            end
        elseif Method == "Raycast" and Settings.Method == Method then
            if ValidateArguments(Arguments, ExpectedArguments.Raycast) then
                local A_Origin = Arguments[2]
                local OriginalDirection = Arguments[3]
                
                if isLocalPlayerShooting(Arguments, Method, A_Origin, OriginalDirection) then
                    local HitPart = currentTarget
                    if HitPart and HitPart.Parent then
                        Arguments[3] = getSpreadDirection(A_Origin, OriginalDirection, HitPart)
                        return oldNamecall(unpack(Arguments))
                    end
                end
            end
        end
    end
    return oldNamecall(...)
end))

-- ============ MAIN LOOP ============
task.spawn(function()
    while task.wait(0.1) do
        if Settings.Enabled then
            currentTarget = getClosestTarget()
        else
            currentTarget = nil
        end
    end
end)

RunService.RenderStepped:Connect(function()
    updateFOVPosition()
    fovCircle.Visible = Settings.Enabled and Settings.FOVEnabled
    
    if Settings.Enabled and currentTarget and currentTarget.Parent then
        if not smoothedTargetPosition then
            smoothedTargetPosition = currentTarget.Position
        else
            smoothedTargetPosition = smoothedTargetPosition:Lerp(currentTarget.Position, Settings.Smoothing)
        end
    else
        smoothedTargetPosition = nil
    end
    
    updateTracers()
end)

-- ============ TARGET HIGHLIGHT ============
RunService.RenderStepped:Connect(function()
    local targetPlayer = nil
    
    if Settings.ESPEnabled and Settings.Enabled and currentTarget and currentTarget.Parent then
        local targetChar = currentTarget.Parent
        if targetChar:IsA("Model") then
            local plr = Players:GetPlayerFromCharacter(targetChar)
            local hum = targetChar:FindFirstChildOfClass("Humanoid")
            local hrp = targetChar:FindFirstChild("HumanoidRootPart")
            
            if plr and hum and hrp and hum.Health > 0 and isValidTarget(plr) then
                targetPlayer = plr
            end
        end
    end
    
    if lastTargetPlayer and lastTargetPlayer ~= targetPlayer then
        if lastTargetPlayer.Character then
            local highlight = lastTargetPlayer.Character:FindFirstChild("ESPHighlight")
            if highlight and highlight:IsA("Highlight") then
                applyESP(lastTargetPlayer) -- Reset para a cor normal
            end
        end
    end
    
    if targetPlayer and targetPlayer.Character then
        local highlight = targetPlayer.Character:FindFirstChild("ESPHighlight")
        if highlight and highlight:IsA("Highlight") then
            highlight.FillColor = Color3.fromRGB(255, 182, 255)
            highlight.OutlineColor = Color3.fromRGB(255, 182, 255)
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0
        end
        
        local head = targetPlayer.Character:FindFirstChild("Head")
        if head then
            local billboard = head:FindFirstChild("ESPNameTag")
            if billboard then
                local label = billboard:FindFirstChild("NameLabel") or billboard:FindFirstChildOfClass("TextLabel")
                if label then
                    label.TextColor3 = Color3.fromRGB(255, 182, 255)
                end
            end
        end
    end
    
    lastTargetPlayer = targetPlayer
end)

-- ============ ESP AUTO REFRESH ============
task.spawn(function()
    while task.wait(0.5) do
        if Settings.ESPEnabled then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= player and plr.Character then
                    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        applyESP(plr)
                    else
                        removeESP(plr)
                    end
                end
            end
        end
    end
end)

-- ============ SPINBOT ============
RunService.RenderStepped:Connect(function()
    if Settings.SpinbotSpeed > 0 then
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(Settings.SpinbotSpeed), 0)
        end
    end
end)

-- ============ KEYBINDS ============
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.LeftControl then
        Settings.Enabled = not Settings.Enabled
        if not Settings.Enabled then
            currentTarget = nil
            smoothedTargetPosition = nil
            removeAllTracers()
        end
    end
end)

player.CharacterAdded:Connect(function()
    camera.CameraType = Enum.CameraType.Custom
    if Settings.ESPEnabled then
        task.wait(0.5)
        updateESP()
    end
end)

