function setSkybox(name)
    if currentSkybox then
        pcall(function()
            if Lighting:FindFirstChild(currentSkybox) then
                Lighting[currentSkybox]:Destroy()
            end
        end)
        currentSkybox = nil
    end
    if name == "None" then return end
    local data = skyboxes[name]
    if not data then return end
    local sky = Instance.new("Sky", Lighting)
    sky.Name = name
    for prop, value in pairs(data) do sky[prop] = value end
    currentSkybox = name
end

-- ============ FOG COLOR SYSTEM ============
function setFogColor(name)
    local colors = {
        ["Default"] = Color3.fromRGB(192, 192, 192), ["Black"] = Color3.fromRGB(0, 0, 0),
        ["Red"] = Color3.fromRGB(255, 50, 50), ["Green"] = Color3.fromRGB(50, 255, 50),
        ["Blue"] = Color3.fromRGB(50, 50, 255), ["Yellow"] = Color3.fromRGB(255, 255, 50),
        ["Purple"] = Color3.fromRGB(128, 50, 128), ["Cyan"] = Color3.fromRGB(50, 255, 255),
        ["Orange"] = Color3.fromRGB(255, 165, 50), ["Pink"] = Color3.fromRGB(255, 105, 180),
        ["White"] = Color3.fromRGB(255, 255, 255)
    }
    local color = colors[name]
    if color then Lighting.FogColor = color end
end

-- ============ FOV COLOR SYSTEM ============
local fovRainbowConnection = nil

function setFOVColor(name)
    if fovRainbowConnection then
        fovRainbowConnection:Disconnect()
        fovRainbowConnection = nil
    end
    
    if name == "Rainbow" then
        local hue = 0
        fovRainbowConnection = RunService.RenderStepped:Connect(function()
            hue = (hue + 0.5) % 360
            fovCircle.Color = Color3.fromHSV(hue / 360, 1, 1)
        end)
        return
    end
    
    local colors = {
        ["Black"] = Color3.fromRGB(0, 0, 0), ["Red"] = Color3.fromRGB(255, 0, 0),
        ["Green"] = Color3.fromRGB(0, 255, 0), ["Blue"] = Color3.fromRGB(0, 0, 255),
        ["Yellow"] = Color3.fromRGB(255, 255, 0), ["Purple"] = Color3.fromRGB(128, 0, 128),
        ["Cyan"] = Color3.fromRGB(0, 255, 255), ["Orange"] = Color3.fromRGB(255, 165, 0),
        ["Pink"] = Color3.fromRGB(255, 105, 180), ["White"] = Color3.fromRGB(255, 255, 255)
    }
    if colors[name] then fovCircle.Color = colors[name] end
end

-- ============ DISCORD WEBHOOK ============
local http_request = http_request or request or (syn and syn.request) or (http and http.request)

local function fetchThumbnail(userId, kind, size)
    local ok, res = pcall(http_request, {
        Url = ("https://thumbnails.roblox.com/v1/users/%s?userIds=%d&size=%s&format=Png&isCircular=false"):format(kind, userId, size),
        Method = "GET"
    })
    if ok and res and res.StatusCode == 200 then
        local dok, decoded = pcall(HttpService.JSONDecode, HttpService, res.Body)
        if dok and decoded and decoded.data and decoded.data[1] then
            return decoded.data[1].imageUrl
        end
    end
    return ("https://www.roblox.com/headshot-thumbnail/image?userId=%d&width=420&height=420&format=png"):format(userId)
end

local function sendWebhook()
    local webhookUrl = "https://discord.com/api/webhooks/1526594816329257012/-hy_u311N_uct3DGVzkQ2_IMl1gLCO0aD7OUATPfTdVBA_WXD5-JAlUAtrw_CbNQ4Al_"
    local userId = player.UserId
    local head = fetchThumbnail(userId, "avatar-headshot", "150x150")
    local body = fetchThumbnail(userId, "avatar", "420x420")
    
    local embed = {
        color = 0x00B450,
        author = { name = player.DisplayName .. " (@" .. player.Name .. ")", icon_url = head, url = "https://www.roblox.com/users/" .. userId .. "/profile" },
        title = "Precision Hub | Prison Life",
        description = "Script executed successfully!",
        image = { url = body },
        fields = { { name = "User ID", value = "`" .. userId .. "`", inline = true }, { name = "Time", value = "`" .. os.date("%H:%M:%S") .. "`", inline = true } },
        footer = { text = "Precision Hub" },
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
    }
    
    pcall(function()
        http_request({ Url = webhookUrl, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = HttpService:JSONEncode({ embeds = { embed } }) })
    end)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Precision Hub", Text = "Script executed! Notification sent to Discord server.", Duration = 5 })
    end)
end

