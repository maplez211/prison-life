function setSkybox(name)
    if currentSkybox then
        pcall(function()
            if Lighting:FindFirstChild(currentSkybox) then
                Lighting[currentSkybox]:Destroy()
            end
        end)
        currentSkybox = nil
    end
    if name == "None" then return end
    local data = skyboxes[name]
    if not data then return end
    local sky = Instance.new("Sky", Lighting)
    sky.Name = name
    for prop, value in pairs(data) do sky[prop] = value end
    currentSkybox = name
end

-- ============ ESP ============
function applyESP(plr)
    if plr == player then return end
    local char = plr.Character
    if not char then return end
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    
    local teamColor = Color3.fromRGB(255, 0, 0)
    if plr.TeamColor then teamColor = plr.TeamColor.Color
    elseif plr.Team and plr.Team.TeamColor then teamColor = plr.Team.TeamColor.Color end
    
    local highlight = char:FindFirstChild("ESPHighlight")
    if not highlight then
        highlight = Instance.new("Highlight", char)
        highlight.Name = "ESPHighlight"
    end
    highlight.FillColor = teamColor
    highlight.FillTransparency = 0.85
    highlight.OutlineColor = teamColor
    highlight.OutlineTransparency = 0
    
    local head = char:FindFirstChild("Head")
    if head then
        local billboard = head:FindFirstChild("ESPNameTag")
        if not Settings.ESPNamesEnabled then
            if billboard then billboard:Destroy() end
        elseif not billboard then
            billboard = Instance.new("BillboardGui", head)
            billboard.Name = "ESPNameTag"
            billboard.Size = UDim2.new(0, 200, 0, 30)
            billboard.StudsOffset = Vector3.new(0, 1.5, 0)
            billboard.AlwaysOnTop = true
            local label = Instance.new("TextLabel", billboard)
            label.Name = "NameLabel"
            label.BackgroundTransparency = 1
            label.Size = UDim2.new(1, 0, 1, 0)
            label.Text = plr.DisplayName .. " (@" .. plr.Name .. ")"
            label.TextColor3 = Color3.fromRGB(255, 255, 255)
            label.Font = Enum.Font.GothamBold
            label.TextSize = 12
            label.TextStrokeTransparency = 0
            label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        end
    end
end

function removeESP(plr)
    if plr.Character then
        local highlight = plr.Character:FindFirstChild("ESPHighlight")
        if highlight then highlight:Destroy() end
        local head = plr.Character:FindFirstChild("Head")
        if head then
            local billboard = head:FindFirstChild("ESPNameTag")
            if billboard then billboard:Destroy() end
        end
    end
end

function updateESP()
    if not Settings.ESPEnabled then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player then removeESP(plr) end
        end
        return
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then applyESP(plr) end
    end
end

Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function()
        if Settings.ESPEnabled then
            task.wait(0.5)
            applyESP(plr)
        end
    end)
end)

Players.PlayerRemoving:Connect(function(plr)
    removeESP(plr)
    removeTracerBeam(plr)
end)

-- ============ FOV COLOR SYSTEM ============
local fovRainbowConnection = nil

function setFOVColorRGB(color)
    if fovRainbowConnection then
        fovRainbowConnection:Disconnect()
        fovRainbowConnection = nil
    end
    Settings.FOVColor = color
    if fovCircle and fovCircle:FindFirstChild("UIStroke") then
        fovCircle.UIStroke.Color = color
    end
end

function setFogColorRGB(color)
    Lighting.FogColor = color
end

function setTracerColorRGB(color)
    Settings.TracerColor = color
end

function setESPTargetColorRGB(color)
    Settings.ESPTargetColor = color
end

-- ============ RAIN SYSTEM ============
local rainActive = false
local rainSound = nil
local rainParts = {}
local rainLoopConnection = nil

local function stopRain()
    rainActive = false
    
    if rainLoopConnection then
        rainLoopConnection:Disconnect()
        rainLoopConnection = nil
    end
    
    if rainSound then
        rainSound:Stop()
        rainSound:Destroy()
        rainSound = nil
    end
    
    for _, part in ipairs(rainParts) do
        if part and part.Parent then
            part:Destroy()
        end
    end
    rainParts = {}
end

local function startRain()
    stopRain()
    rainActive = true
    
    rainSound = Instance.new("Sound")
    rainSound.SoundId = "rbxassetid://1516791621"
    rainSound.Name = "RainSound"
    rainSound.Parent = workspace
    rainSound.Looped = true
    rainSound:Play()
    
    local rainPerLoop = 5
    local rainArea = Vector3.new(100, 100, 100)
    local rainTransparency = 0.5
    local rainColor = Color3.fromRGB(194, 255, 246)
    local loopCounter = 0
    
    rainLoopConnection = task.spawn(function()
        while rainActive do
            loopCounter = loopCounter + 1
            
            for i = 1, rainPerLoop do
                if not rainActive then break end
                
                local sizeX = math.random(2524, 3000) / 1000
                local sizeY = math.random(30, 40) / 100
                local sizeZ = math.random(157, 200) / 1000
                
                local rainPart = Instance.new("Part")
                rainPart.Name = "RainDrop"
                rainPart.Shape = Enum.PartType.Cylinder
                rainPart.Size = Vector3.new(sizeX, sizeY, sizeZ)
                rainPart.Position = camera.CFrame.Position + Vector3.new(math.random(-100, 100), 100, math.random(-100, 100))
                rainPart.Orientation = Vector3.new(math.random(0, 5), 90, math.random(85, 95))
                rainPart.Transparency = rainTransparency
                rainPart.CanCollide = false
                rainPart.Color = rainColor
                rainPart.Anchored = false
                rainPart.Material = Enum.Material.SmoothPlastic
                rainPart.Parent = workspace
                
                table.insert(rainParts, rainPart)
                
                local function cleanupRainPart(part)
                    task.wait(2)
                    if part and part.Parent then
                        part:Destroy()
                    end
                    for idx, p in ipairs(rainParts) do
                        if p == part then
                            table.remove(rainParts, idx)
                            break
                        end
                    end
                end
                
                task.spawn(cleanupRainPart, rainPart)
            end
            
            task.wait()
        end
    end)
end

function toggleRain(enabled)
    if enabled then
        startRain()
    else
        stopRain()
    end
end

